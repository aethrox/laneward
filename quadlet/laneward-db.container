[Unit]
Description=Laneward Postgres database

[Container]
Image=docker.io/library/postgres:16-alpine
ContainerName=laneward-db
Environment=POSTGRES_USER=laneward
Environment=POSTGRES_PASSWORD=laneward
Environment=POSTGRES_DB=laneward
# The placeholder below is substituted by install.sh; see systemd/laneward.service for why
# this is not %h.
Volume=@DATA_DIR@/pgdata:/var/lib/postgresql/data:Z
PublishPort=127.0.0.1:5433:5432

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
