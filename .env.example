DATABASE_URL=postgres://laneward:laneward@localhost:5433/laneward
MAX_ACTIVE_LANES=3
PORT=8787
# No default agent ships. Set this to a known preset (codex, claude), or give
# LANEWARD_AGENT_WRITE a raw JSON argument array instead. Without one of the
# two, the first lane fails with a refusal naming both ways to declare one.
LANEWARD_AGENT=
# Comma-separated: approval_required,lane_failed,plan_ready_for_review,findings_to_adjudicate. Empty disables desktop alerts.
# The default stays the two classes that block work. Reader findings are always
# visible on the dashboard and in GET /pending, so their toast is opt-in per D-035.
LANEWARD_NOTIFY=approval_required,lane_failed
